  "iq": {
    "points_per_fragment": 256,
    "fragments_per_window": 4,
    "bytes_per_point": 4,
    "window_points": 1024
  },
  "crc": "CRC-32/ISO-HDLC over the raw payload only",
  "reassembly_key": [
    "type",
    "stream_id",
    "capture_id",
    "window_seq"
  ],
  "discard_on": [
    "missing_fragment",
    "duplicate_conflicting_fragment",
    "header_mismatch",
    "crc_failure",
    "timeout"
  ],
  "data_flags": {
    "discontinuity": 1,
    "first_window_of_capture": 2,
    "overload": 4,
    "event_mode": 8
  },
  "continuous_mode": {
    "hop_points": 1024,
    "sample_index": "window_seq * 1024",
    "overlap_reassembled_on_receiver": true
  },
  "reassembly": {
    "timeout_ms": 100,
    "max_windows_per_stream": 256,
    "sequence_bandwidth": 256,
    "identical_duplicate": "ignore",
    "conflicting_duplicate": "invalidate_window",
    "publish": "strictly_increasing_window_seq",
    "capture": "acknowledged_START_only"
  },
  "control": {
    "magic": "RFCT",
    "version": 1,
    "header_bytes": 32,
    "response_payload_bytes": 96,
    "max_payload_bytes": 1440,
