    "kind": {
      "request": 0,
      "response": 1
    },
    "commands": {
      "SET_RF": 1,
      "SET_STREAM": 2,
      "START": 3,
      "STOP": 4,
      "GET_STATUS": 5,
      "GET_RX_INFO": 6
