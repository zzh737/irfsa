    "statuses": {
      "OK": 0,
      "BAD_COMMAND": 1,
      "BAD_LENGTH": 2,
      "BAD_PARAMETER": 3,
      "BAD_STATE": 4,
      "UNSUPPORTED": 5,
      "BUSY": 6,
      "HW_TIMEOUT": 7,
      "HW_FAILURE": 8,
      "BOOT_MISMATCH": 9,
      "REQUEST_CONFLICT": 10,
      "STALE_REQUEST": 11,
      "CONFIG_CONFLICT": 12,
      "CAPTURE_REUSED": 13
