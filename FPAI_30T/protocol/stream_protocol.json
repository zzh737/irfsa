    "request_payload_bytes": {
      "SET_RF": 24,
      "SET_STREAM": 28,
      "START": 4,
      "STOP": 0,
      "GET_STATUS": 0,
      "GET_RX_INFO": 0
    },
    "crc": "CRC-32/ISO-HDLC over header with bytes 28..31 zeroed plus payload",
    "retry_interval_ms": 500,
    "max_retries_after_initial_send": 12,
    "start_execution_timeout_ms": 5000,
    "stop_execution_timeout_ms": 1000,
    "request_idempotency": true,
    "minimum_cached_results": 64,
    "minimum_result_retention_seconds": 60,
    "capture_id_owner": "wujing_persistent_non_reusing_u32",
    "boot_id_owner": "ku5p_persistent_non_reusing_u32",
    "apply_policy": "IDLE_SET_RF_SET_STREAM_then_START_atomic_commit",
    "states": {
      "IDLE": 0,
      "STARTING": 1,
      "RUNNING": 2,
      "STOPPING": 3,
      "ERROR": 4
